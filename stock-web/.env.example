# Copy to .env.local for local development. On Vercel, set these under Project → Settings → Environment Variables.

# Azure Function endpoint (no query string).
AZURE_FUNCTION_URL=https://hello-func-usb275.azurewebsites.net/api/stockhistory

# Optional: only needed if the function's auth level is changed to FUNCTION.
AZURE_FUNCTION_KEY=

# Comma-separated symbols shown in the dropdown.
STOCK_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA
